{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    /* The Workers runtime, not the DOM and not Node. `fetch`, `Request` and
       `Response` exist in all three with quietly different shapes, so the
       project that compiles the Worker has to name its own — the same reason
       tsconfig.app.json takes only `vite/client` and tsconfig.node.json only
       `node`. */
    "types": ["@cloudflare/workers-types"],
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["**/*.ts"]
}
