# Base URL of the BullLedger API, without a trailing slash. Required —
# src/config/env.ts throws at boot if it is missing or malformed.
VITE_API_URL=https://bull-ledger.voynan.com

# Google OAuth client id. Optional: Google sign-in is disabled while unset.
# Consumed from Phase 2 onward.
# VITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Donations
#
# Where a contribution to the project goes. Every variable below is optional:
# /app/donate lists only the methods that are configured, and shows an empty
# state when none of them are. Leave a line commented out rather than blank —
# a variable that is present but empty fails at boot, on purpose.
#
# These are RECEIVING addresses and they ship to the browser. Vite inlines
# every VITE_ variable into the public bundle, so a private key or a seed
# phrase must never appear in this file. Paste only what someone pays into.
# ---------------------------------------------------------------------------

# Brazil. A random PIX key (chave aleatória), in its UUID form.
# VITE_DONATE_PIX_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Bitcoin, on-chain. Native SegWit (bc1…) or any address you control.
# VITE_DONATE_BTC_ADDRESS=bc1...

# Ethereum / EVM. Also receives USDT and USDC on ERC-20.
# VITE_DONATE_ETH_ADDRESS=0x...

# USDT on Tron (TRC20). A different chain from the one below, and a different
# address — the screen labels each with its network because sending USDT to
# the wrong chain's address loses the money.
# VITE_DONATE_USDT_TRC20_ADDRESS=T...

# USDT on Solana (SPL).
# VITE_DONATE_USDT_SOLANA_ADDRESS=...
