{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bull-ledger-web",
  // Pins the Workers runtime behaviour to what this code was tested against.
  // Bump it deliberately, never on every deploy: a newer date can change
  // runtime semantics under an unchanged bundle.
  "compatibility_date": "2026-08-16",
  "observability": {
    "enabled": true,
  },
  // The Worker owns the whole hostname, so `workers.dev` stays off — one
  // origin for the SPA means one origin for the API's credentialed CORS and
  // cookie `Domain` to allow.
  "workers_dev": false,
  "routes": [
    {
      // Fill both in before the first deploy. `--dry-run` only warns about
      // these placeholders; the real deploy is what fails, on the unknown
      // zone. `pattern` is a route match, so it needs the path too:
      // `app.voynan.com/*`, not `app.voynan.com`. `zone_id` is the zone's ID
      // on the Cloudflare dashboard overview, and the hostname needs a
      // proxied DNS record in that zone.
      "pattern": "<DOMAIN_ROUTE_PATTERN>",
      "zone_id": "<YOUR_ZONE_ID>",
    },
  ],
  "assets": {
    // `bun run build` writes here (Vite's default `outDir`).
    "directory": "./dist",
    // This is the whole reason the SPA works on a hard refresh. TanStack
    // Router owns every path under `/app`, and none of them exist as files:
    // without this, `GET /app/accounts` typed into the address bar is a 404
    // from the asset server before React ever loads. Serving `index.html`
    // for unmatched paths hands routing back to the client.
    //
    // Hashed files under `/assets/*` still match on their own, so this never
    // masks a genuinely missing bundle with an HTML response.
    "not_found_handling": "single-page-application",
  },
}
